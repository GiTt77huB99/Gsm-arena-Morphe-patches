{
  "name": "@cleyrop-org/semantic-release-backmerge",
  "description": "semantic-release plugin to back-merge releases into development branches. Fork of @saithodev/semantic-release-backmerge by Mario Lubenka, maintained by Cleyrop Organization.",
  "version": "6.2.0",
  "author": "Jean Humann <jean@cleyrop.com>",
  "contributors": [
    {
      "name": "Mario Lubenka",
      "url": "https://github.com/saitho"
    }
  ],
  "license": "MIT",
  "type": "module",
  "keywords": [
    "semantic-release",
    "git",
    "backmerge",
    "git-flow",
    "release",
    "automation",
    "ci-cd",
    "gitlab",
    "github"
  ],
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/cleyrop-org/semantic-release-backmerge.git"
  },
  "homepage": "https://gitlab.com/cleyrop-org/semantic-release-backmerge",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:build": "typedoc --out ./docs ./src/ && touch ./docs/.nojekyll",
    "test": "c8 ava",
    "test:watch": "ava --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "semantic-release": "semantic-release",
    "commit": "git-cz"
  },
  "dependencies": {
    "@semantic-release/error": "^4.0.0",
    "aggregate-error": "^5.0.0",
    "debug": "^4.4.3",
    "execa": "^9.6.1",
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "semantic-release": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.3.2",
    "@types/debug": "^4.1.13",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.19.20",
    "@types/semantic-release__error": "^3.0.3",
    "@types/sinon": "^21.0.1",
    "ava": "^8.0.0",
    "c8": "^11.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-n": "^18.1.0",
    "esmock": "^2.7.6",
    "semantic-release": "^25.0.5",
    "sinon": "^22.0.0",
    "ts-mockito": "^2.6.1",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "c8": {
    "all": true,
    "src": [
      "src"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "src/test-utils.ts",
      "src/test-fixtures/**",
      "src/types/**",
      "src/definitions/config.ts"
    ],
    "reporter": [
      "text",
      "lcovonly",
      "cobertura"
    ],
    "reports-dir": "coverage"
  }
}
